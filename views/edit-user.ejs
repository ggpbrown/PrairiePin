<!-- views/edit-user.ejs -->
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Edit User</title>
  <script src="https://cdn.tailwindcss.com"></script>
        <script>
        tailwind.config = {
            theme: {
            extend: {
                colors: {
                primary: '#085e46',
                accent: '#8cc084',
                softgreen: '#F1FDF4',
                softgray: '#F5F6F8',
                steel: '#91a2a8'
            }
            }
            }
        }
        </script>
</head>
<body class="bg-gray-100 min-h-screen">
    <header class="bg-softgreen shadow-md p-4 flex justify-between items-center">
        <h1 class="text-2xl font-bold text-primary">Edit User</h1>
        <div class="space-x-4">
            <a href="/admin" class="text-blue-600 hover:underline">← Back to Admin</a>
            <a href="/logout" class="text-red-600 hover:underline">Logout</a>
        </div>
    </header>
  <main class="max-w-xl mx-auto mt-10 p-6 bg-white shadow rounded-lg">
  <form action="/admin/user/<%= user.id %>/edit" method="POST" class="space-y-4">

    <div>
      <label class="block text-sm font-medium text-gray-700">First Name</label>
      <input type="text" name="first_name" value="<%= user.first_name %>"
        class="mt-1 block w-full border-gray-300 rounded-md shadow-sm focus:ring-accent focus:border-accent" />
    </div>

    <div>
      <label class="block text-sm font-medium text-gray-700">Last Name</label>
      <input type="text" name="last_name" value="<%= user.last_name %>"
        class="mt-1 block w-full border-gray-300 rounded-md shadow-sm focus:ring-accent focus:border-accent" />
    </div>

    <div>
      <label class="block text-sm font-medium text-gray-700">Email</label>
      <input type="email" name="email" value="<%= user.email %>"
        class="mt-1 block w-full border-gray-300 rounded-md shadow-sm focus:ring-accent focus:border-accent" />
    </div>

    <div class="flex space-x-4">
      <div class="flex-1">
        <label class="block text-sm font-medium text-gray-700">New Password</label>
        <input type="password" name="password"
          class="mt-1 block w-full border-gray-300 rounded-md shadow-sm focus:ring-accent focus:border-accent" />
      </div>
      <div class="flex-1">
        <label class="block text-sm font-medium text-gray-700">Confirm Password</label>
        <input type="password" name="confirm_password"
          class="mt-1 block w-full border-gray-300 rounded-md shadow-sm focus:ring-accent focus:border-accent" />
      </div>
    </div>
    <div class="mb-4">
    <label for="address1" class="block font-semibold text-primary mb-1">Address Line 1</label>
    <input type="text" name="address_line1" id="address1" value="<%= user.address_line1 || '' %>" class="w-full border border-gray-300 rounded px-3 py-2">
    </div>

    <div class="mb-4">
    <label for="address2" class="block font-semibold text-primary mb-1">Address Line 2</label>
    <input type="text" name="address_line2" id="address2" value="<%= user.address_line2 || '' %>" class="w-full border border-gray-300 rounded px-3 py-2">
    </div>

    <div class="mb-4">
    <label for="city" class="block font-semibold text-primary mb-1">City</label>
    <input type="text" name="city" id="city" value="<%= user.city || '' %>" class="w-full border border-gray-300 rounded px-3 py-2">
    </div>

    <div class="mb-4">
    <label for="province_state" class="block font-semibold text-primary mb-1">Province</label>
    <input type="text" name="province_state" id="province_state" value="<%= user.province_state || '' %>" class="w-full border border-gray-300 rounded px-3 py-2">
    </div>

    <div class="mb-4">
    <label for="postal_code" class="block font-semibold text-primary mb-1">Postal Code</label>
    <input type="text" name="postal_code" id="postal_code" value="<%= user.postal_code || '' %>" class="w-full border border-gray-300 rounded px-3 py-2">
    </div>

    <div class="mb-4">
    <label for="country" class="block font-semibold text-primary mb-1">Country</label>
    <input type="text" name="country" id="country" value="<%= user.country || '' %>" class="w-full border border-gray-300 rounded px-3 py-2">
    </div>

    <div class="mb-4">
    <label for="is_admin" class="block font-semibold text-primary mb-1">Admin Privileges</label>
    <input type="checkbox" name="is_admin" id="is_admin" <%= user.is_admin ? 'checked' : '' %> class="mr-2">
    <span class="text-sm text-gray-700">Grant admin access</span>
    </div>
    <div class="pt-4">
      <button type="submit"
        class="bg-accent text-white px-4 py-2 rounded hover:bg-green-700 transition font-medium">
        Update User
      </button>
    </div>
  </form>
</main>
</body>
</html>