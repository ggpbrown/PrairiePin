<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Admin Dashboard – PrairiePin</title>
  <script src="https://cdn.tailwindcss.com"></script>
</head>
<body class="bg-gray-100 text-gray-900 font-sans min-h-screen">
  <%- include('partials/header') %>
  <main class="max-w-6xl mx-auto px-6 py-8 mt-10 bg-white shadow-md rounded-md">
    <!-- debug info -->
    <div class="bg-blue-50 border border-blue-300 p-4 my-6 rounded text-sm">
        <p>User: <%= user.firstName %></p>
        <p>isAdmin: <%= user.isAdmin %></p>
        <p>isOrgAdmin: <%= user.isOrgAdmin %></p>
    </div>

  <% if (user.isAdmin) { %>
    <h1 class="text-3xl font-bold mb-6 text-center">SysAdmin Dashboard</h1>

    <div class="flex justify-center my-4 space-x-2">
        <button
            id="users-tab"
            class="px-4 py-2 rounded font-medium text-white bg-green-700 hover:bg-green-800"
            onclick="showTab('users')"
        >
            Users
        </button>
        <button
            id="organizations-tab"
            class="px-4 py-2 rounded font-medium text-green-700 bg-gray-200 hover:bg-gray-300"
            onclick="showTab('organizations')"
        >
            Organizations
        </button>
    </div>

    <div id="tab-users" style="display: none;">
      <%- include('partials/admin-users') %>
    </div>

    <div id="tab-orgs" style="display: none;">
      <%- include('partials/admin-orgs') %>
    </div>
  <% } else if (user.isOrgAdmin) { %>
    <h1 class="text-3xl font-bold mb-6 text-center">Organization Admin Dashboard</h1>

    <div id="tab-users">
      <%- include('partials/org-admin-users') %>
    </div>
  <% } else { %>
    <p class="text-center text-red-600">You do not have admin access.</p>
  <% } %>
  </main>
  <script>
  function showTab(tab) {
    const tabs = ['users', 'organizations'];

    tabs.forEach(id => {
      const panel = document.getElementById(`tab-${id}`);
      const button = document.getElementById(`${id}-tab`);
      
      const isActive = id === tab;
      panel.style.display = isActive ? 'block' : 'none';

      if (isActive) {
        button.classList.add('bg-green-700', 'text-white');
        button.classList.remove('bg-gray-200', 'text-green-700');
      } else {
        button.classList.remove('bg-green-700', 'text-white');
        button.classList.add('bg-gray-200', 'text-green-700');
      }
    });
  }

  document.addEventListener('DOMContentLoaded', () => showTab('users'));
</script>
</body>
</html>