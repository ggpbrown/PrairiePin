<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Add New Organization</title>
  <script src="https://cdn.tailwindcss.com"></script>
  <script>
    tailwind.config = {
      theme: {
        extend: {
          colors: {
            primary: '#085ecd',
            accent: '#8cc084',
            softgreen: '#F1FDF4',
            softgray: '#F5F6F8',
            steel: '#91a2a8'
          }
        }
      }
    }
  </script>
</head>
<body class="bg-gray-100 min-h-screen">

  <header class="bg-softgreen p-4 shadow flex justify-between items-center">
    <div>
      <img src="/images/prairiepin-logo.png" alt="PrairiePin Logo" class="h-10">
      <p class="text-sm text-steel">Because the grid doesn't have street signs.</p>
    </div>
    <div class="flex gap-4">
      <a href="/dashboard.html" class="text-accent hover:underline">← Back to Dashboard</a>
      <a href="/admin" class="text-blue-600 hover:underline">← Back to Admin</a>
      <a href="#" onclick="logout()" class="bg-red-600 text-white px-4 py-1 rounded hover:bg-red-700 text-sm">Logout</a>
    </div>
  </header>

  <main class="max-w-xl mx-auto mt-10 p-6 bg-white shadow rounded-lg">
    <% if (typeof error !== 'undefined') { %>
      <p class="text-red-600 font-semibold mb-4"><%= error %></p>
    <% } %>
    <h1 class="text-xl font-bold mb-6">Add New Organization</h1>
    <form action="/admin/organization/create" method="POST" class="space-y-4">

      <div class="mb-4">
        <label class="block font-semibold">Organization Name</label>
        <input type="text" name="name" value="<%= formData?.name || '' %>" class="w-full border border-gray-300 rounded px-3 py-2">
      </div>

      <div class="mb-4">
        <label class="block font-semibold">Contact First Name</label>
        <input type="text" name="contact_first_name" value="<%= formData?.contact_first_name || '' %>" class="w-full border border-gray-300 rounded px-3 py-2">
      </div>

      <div class="mb-4">
        <label class="block font-semibold">Contact Last Name</label>
        <input type="text" name="contact_last_name" value="<%= formData?.contact_last_name || '' %>" class="w-full border border-gray-300 rounded px-3 py-2">
      </div>

      <div class="mb-4">
        <label class="block font-semibold">Contact Email</label>
        <input type="email" name="contact_email" value="<%= formData?.contact_email || '' %>" class="w-full border border-gray-300 rounded px-3 py-2">
      </div>

      <div class="mb-4">
        <label class="block font-semibold">Contact Phone</label>
        <input type="text" name="contact_phone" value="<%= formData?.contact_phone || '' %>" class="w-full border border-gray-300 rounded px-3 py-2">
      </div>

      <div class="mb-4">
        <label class="block font-semibold">Billing Address</label>
        <textarea name="billing_address" rows="3" class="w-full border border-gray-300 rounded px-3 py-2"><%= formData?.billing_address || '' %></textarea>
      </div>

      <div class="mb-4">
        <label class="block font-semibold text-primary mb-1">Organization Active</label>
        <input type="checkbox" name="isActive" id="isActive" <%= formData?.isActive ? 'checked' : '' %> class="mr-2">
        <span class="text-sm text-gray-700">Active</span>
      </div>

      <div class="pt-4">
        <button type="submit"
          class="bg-accent text-white px-4 py-2 rounded hover:bg-green-700 transition font-medium">
          Create Organization
        </button>
      </div>

    </form>
  </main>

  <script>
    function logout() {
      localStorage.removeItem('token');
      document.cookie = "token=; Max-Age=0; path=/";
      window.location.href = '/login.html';
    }
  </script>
</body>
</html>