<!-- views/partials/admin-users.ejs -->
<div class="bg-white shadow-md rounded-lg overflow-hidden">
  <h2 class="text-xl font-semibold px-6 py-4 bg-gray-100 border-b border-gray-200">User Management</h2>
  <div class="overflow-x-auto">
    <table class="min-w-full text-sm text-left">
      <thead class="bg-gray-50">
        <tr>
          <th class="px-6 py-3 text-xs font-medium text-gray-500 uppercase">Name</th>
          <th class="px-6 py-3 text-xs font-medium text-gray-500 uppercase">Email</th>
          <th class="px-6 py-3 text-xs font-medium text-gray-500 uppercase">Organization</th>
          <th class="px-6 py-3 text-xs font-medium text-gray-500 uppercase">Last Login</th>
          <th class="px-6 py-3 text-xs font-medium text-gray-500 uppercase">Role</th>
        </tr>
      </thead>
      <tbody class="divide-y divide-gray-200">
        <% users.forEach(user => { %>
          <tr>
            <td class="px-6 py-4 font-medium text-gray-800">
              <a href="/user/profile/<%= user.id %>" class="text-blue-600 hover:underline">
                <%= user.first_name %> <%= user.last_name %>
              </a>
            </td>
            <td class="px-6 py-4 text-gray-700"><%= user.email %></td>
            <td class="px-6 py-4 text-gray-700"><%= user.organization_name || '—' %></td>
            <td class="px-6 py-4 text-gray-600"><%= user.last_login ? user.last_login.toISOString().split('T')[0] : '—' %></td>
            <td class="px-6 py-4 text-green-700 font-semibold">
              <% if (user.isadmin) { %>
                SysAdmin
              <% } else if (user.isorgadmin) { %>
                OrgAdmin
              <% } else { %>
                User
              <% } %>
            </td>
          </tr>
        <% }) %>
      </tbody>
    </table>
  </div>
</div>