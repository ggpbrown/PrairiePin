


<section class="max-w-4xl mx-auto my-10 px-4">
  <h2 class="text-2xl font-semibold text-gray-800 mb-4">Organization Users</h2>
  <p class="text-gray-600 mb-6">Here you can view users in your organization. (Edit/Delete coming soon)</p>
  
  <table class="min-w-full bg-white border border-gray-200 shadow-sm">
    <thead class="bg-gray-100">
      <tr>
        <th class="text-left py-2 px-4 border-b border-gray-200">Name</th>
        <th class="text-left py-2 px-4 border-b border-gray-200">Email</th>
        <th class="text-left py-2 px-4 border-b border-gray-200">Last Login</th>
        <th class="text-left py-2 px-4 border-b border-gray-200">Total Lookups</th>
      </tr>
    </thead>
    <tbody id="orgUsersTableBody">
        <% if (typeof orgUsers !== 'undefined' && orgUsers.length > 0) { %>
        <% orgUsers.forEach(user => { %>
            <tr>
            <td class="py-2 px-4 border-b border-gray-200"><%= user.first_name %> <%= user.last_name %></td>
            <td class="py-2 px-4 border-b border-gray-200"><%= user.email %></td>
            <td class="py-2 px-4 border-b border-gray-200">
                <%= user.last_login ? new Date(user.last_login).toLocaleString() : 'Never' %>
            </td>
            <td class="py-2 px-4 border-b border-gray-200"><%= user.total_lookups || 0 %></td>
            </tr>
        <% }) %>
        <% } else { %>
        <tr>
            <td colspan="4" class="py-4 px-4 text-center text-gray-500">No users found in your organization.</td>
        </tr>
        <% } %>    
    </tbody>
  </table>
</section>