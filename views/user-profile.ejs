<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <title>User Profile - <%= user.first_name %> <%= user.last_name %></title>
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <script src="https://cdn.tailwindcss.com"></script>
    <script>
    tailwind.config = {
        theme: {
        extend: {
           colors: {
            primary: '#085e46',
            accent: '#8cc084',
            softgreen: '#F1FDF4',
            softgray: '#F5F6F8',
            steel: '#91a2a8'
          }
        }
        }
    };
    </script>
</head>
<body class="bg-gray-50 text-gray-800">

  <header class="bg-softgreen p-4 shadow flex justify-between items-center">
    <div>
      <img src="/images/prairiepin-logo.png" alt="PrairiePin Logo" class="h-10">
      <p class="text-sm text-steel">Because the grid doesn't have street signs.</p>
    </div>
    <div class="flex gap-4">
      <a href="/dashboard.html" class="text-accent hover:underline">← Back to Dashboard</a>
      <a href="/admin" class="text-blue-600 hover:underline">← Back to Admin</a>
      <a href="#" onclick="logout()" class="bg-red-600 text-white px-4 py-1 rounded hover:bg-red-700 text-sm">Logout</a>
    </div>
  </header>

  

  <main class="max-w-5xl mx-auto p-6 bg-white mt-6 rounded-lg shadow-lg">
    <section class="mb-6">
      <h2 class="text-2xl font-bold mb-2"><%= user.first_name %> <%= user.last_name %></h2>
      <div class="mb-6 text-steel text-sm">
        <p><span class="font-semibold text-black">Email:</span> <%= user.email %></p>
        <p><span class="font-semibold text-black">Last Login:</span> <%= user.last_login ? new Date(user.last_login).toLocaleString() : 'Never' %></p>
    </div>
    </section>
    <div class="mt-6">
        <a href="/admin/user/<%= user.id %>/edit"
            class="inline-block bg-accent text-white font-medium px-4 py-2 rounded hover:bg-green-700 transition">
            ✏️ Edit User
        </a>
    </div>
    <section>
    <h2 class="text-lg font-semibold text-primary mb-3">Recent Lookups</h2>
      <% if (lookups.length === 0) { %>
        <p class="text-gray-500">No lookups found for this user.</p>
      <% } else { %>
        <div class="overflow-x-auto">
            <table class="min-w-full border text-sm shadow rounded">
                <thead class="bg-softgreen text-primary font-semibold">
                <tr>
                    <th class="px-3 py-2 text-left">LLD</th>
                    <th class="px-3 py-2 text-left">Latitude</th>
                    <th class="px-3 py-2 text-left">Longitude</th>
                    <th class="px-3 py-2 text-left">Province/State</th>
                    <th class="px-3 py-2 text-left">Date</th>
                </tr>
                </thead>
                <tbody>
                <% lookups.forEach((lookup, index) => { %>
                    <tr class="<%= index % 2 === 0 ? 'bg-white' : 'bg-softgreen' %>">
                    <td class="px-3 py-2"><%= lookup.lld_entered %></td>
                    <td class="px-3 py-2"><%= lookup.latitude %></td>
                    <td class="px-3 py-2"><%= lookup.longitude %></td>
                    <td class="px-3 py-2"><%= lookup.province %></td>
                    <td class="px-3 py-2"><%= new Date(lookup.timestamp).toLocaleString() %></td>
                    </tr>
                <% }) %>
                </tbody>
            </table>
            </div>
      <% } %>
    </section>
  </main>

</body>
</html>