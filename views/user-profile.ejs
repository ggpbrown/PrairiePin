<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <title>User Profile - <%= user.first_name %> <%= user.last_name %></title>
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <script src="https://cdn.tailwindcss.com"></script>
</head>
<body class="bg-gray-50 text-gray-800">

  <header class="bg-white shadow-md p-4 flex justify-between items-center">
    <h1 class="text-xl font-semibold">User Profile</h1>
    <div class="space-x-4">
      <a href="/dashboard" class="text-blue-600 hover:underline">← Back to Dashboard</a>
      <a href="/admin" class="text-blue-600 hover:underline">← Back to Admin</a>
    </div>
  </header>

  <main class="max-w-5xl mx-auto p-6 bg-white mt-6 rounded-lg shadow-lg">
    <section class="mb-6">
      <h2 class="text-2xl font-bold mb-2"><%= user.first_name %> <%= user.last_name %></h2>
      <p><span class="font-semibold">Email:</span> <%= user.email %></p>
      <p><span class="font-semibold">Account Created:</span> <%= new Date(user.created_at).toLocaleString() %></p>
      <p><span class="font-semibold">Last Login:</span> <%= user.last_login ? new Date(user.last_login).toLocaleString() : 'Never' %></p>
    </section>

    <section>
      <h3 class="text-xl font-semibold mb-4">Recent Lookups</h3>
      <% if (lookups.length === 0) { %>
        <p class="text-gray-500">No lookups found for this user.</p>
      <% } else { %>
        <div class="overflow-x-auto">
          <table class="min-w-full border border-gray-200">
            <thead class="bg-gray-100">
              <tr>
                <th class="text-left px-4 py-2 border-b">LLD</th>
                <th class="text-left px-4 py-2 border-b">Latitude</th>
                <th class="text-left px-4 py-2 border-b">Longitude</th>
                <th class="text-left px-4 py-2 border-b">Province/State</th>
                <th class="text-left px-4 py-2 border-b">Date</th>
              </tr>
            </thead>
            <tbody>
              <% lookups.forEach((lookup, index) => { %>
                <tr class="<%= index % 2 === 0 ? 'bg-white' : 'bg-gray-50' %>">
                  <td class="px-4 py-2"><%= lookup.lld_entered %></td>
                  <td class="px-4 py-2"><%= lookup.latitude %></td>
                  <td class="px-4 py-2"><%= lookup.longitude %></td>
                  <td class="px-4 py-2"><%= lookup.province %></td>
                  <td class="px-4 py-2"><%= new Date(lookup.created_at).toLocaleString() %></td>
                </tr>
              <% }) %>
            </tbody>
          </table>
        </div>
      <% } %>
    </section>
  </main>

</body>
</html>